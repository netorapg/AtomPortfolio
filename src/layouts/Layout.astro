---
interface Props {
    title: string;
}
const {title} = Astro.props;
---

<!doctype html>
<html lang="pt-BR"> 
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
    <!-- Importando Fontes: Inter (Textos) e Fira Code (Código) -->
     <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    </head>
    <body>
    <!-- Header Flutuante / Glassmorphism -->
    <header class="navbar">
        <nav>
            <a href="#hero">~/inicio</a>
            <a href="#experiencia">~/experiencia</a>
            <a href="#stack">~/stack</a>
            <a href="#projetos">~/projetos</a>
        </nav>
    </header>

            <slot />
    </body>
</html>

<style is:global>
        :root {
            --bg-color: #0f1115;
            --text-color: #e5e7eb;
            --accent-cyan: #00f0ff;
            --surface-color: #1a1d24;
        }

        html {
            font-family: 'Inter', sans-serif;
            background: var(--bg-color);
            color: var(--text-color);
            scroll-behavior: smooth;
        }
    
    body {
        margin: 0;
        padding: 0;
    }

    h1, h2, h3 {
        font-family: 'Fira Code', monospace;
    }

    .navbar {
        position: fixed;
        top: 0;
        width: 100%;
        background: rgba(15, 17, 21, 0.8);
        padding: 1rem 0;
        z-index: 100;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        text-align: center;
    }

    .navbar a {
        color: var(--text-color);
        text-decoration: none;
        margin: 0 1rem;
        font-family: 'Fira Code', monospace;
        font-size: 0.9rem;
        transition: color 0.3s ease;
    }

    .navbar a:hover {
        color: var(--accent-cyan);
    }

    section {
        min-height: 100vh;
        padding: 6rem 2rem 2rem 2rem;
        max-width: 1000px;
        margin: 0 auto;
    }
</style>