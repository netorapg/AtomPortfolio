---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import profilePhoto from "../assets/perfil.jpg";

const allStack = (await getCollection("stack")).sort(
	(a, b) => a.data.order - b.data.order
);
---

<section id="hero">
	<div class="card hero-card">
		<div class="hero-content">
			<div class="hero-text">
				<h1><span class="cyan">❯</span> Renato Augusto</h1>
				<h2>
					<span class="lang-pt">Engenheiro de Software</span>
					<span class="lang-en">Software Engineer</span>
				</h2>
				<p class="lang-pt">
					Construo apps mobile e os backends por trás deles. Hoje
					mantenho em produção um app Flutter de varejo e a API
					multi-tenant em .NET que ele consome, com picos de 1.200+
					requisições simultâneas. Gosto de entender o que acontece
					por baixo: escrevi um motor de jogo 2D do zero em C++ e
					publiquei um artigo sobre ele.
				</p>
				<p class="lang-en">
					I build mobile apps and the backends behind them. Right
					now I run a Flutter retail app in production and the
					multi-tenant .NET API it talks to, with peaks of 1,200+
					concurrent requests. I like knowing how things work
					underneath: I wrote a 2D game engine from scratch in C++
					and published a paper about it.
				</p>
			</div>

			<div class="hero-image-wrapper">
				<Image
					src={profilePhoto}
					alt="Foto de Renato Augusto"
					data-alt-pt="Foto de Renato Augusto"
					data-alt-en="Photo of Renato Augusto"
					width={440}
					loading="eager"
					fetchpriority="high"
				/>
			</div>
		</div>

		<div class="hero-stack" id="stack">
			<h3 class="hero-stack-title">
				<span class="cyan">#</span>
				<span class="lang-pt">Stack & Infraestrutura</span>
				<span class="lang-en">Stack & Infrastructure</span>
			</h3>
			{
				allStack.map((group) => (
					<div class="hero-stack-row">
						<span class="hero-stack-label">
							<span class="lang-pt">{group.data.category}</span>
							<span class="lang-en">{group.data.en?.category ?? group.data.category}</span>
						</span>
						<div class="tags">
							{group.data.items.map((item) => (
								<span>{item}</span>
							))}
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
