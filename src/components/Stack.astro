---
import { getCollection } from "astro:content";

const allStack = (await getCollection("stack")).sort(
	(a, b) => a.data.order - b.data.order
);
---

<section id="stack">
	<h2><span class="cyan">#</span> Stack & Infraestrutura</h2>
	<div class="stack-grid">
		{
			allStack.map((group) => (
				<div class="stack-category">
					<h3>{group.data.category}</h3>
					<div class="tags">
						{group.data.items.map((item) => (
							<span>{item}</span>
						))}
					</div>
				</div>
			))
		}
	</div>
</section>
