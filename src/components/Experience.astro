---
import { getCollection } from "astro:content";

const allExperience = (await getCollection("experience")).sort(
	(a, b) => a.data.order - b.data.order
);
---

<section id="experiencia">
	<h2>
		<span class="cyan">#</span>
		<span class="lang-pt">Experiência Profissional</span>
		<span class="lang-en">Professional Experience</span>
	</h2>
	{
		allExperience.map((exp) => (
			<div class="card">
				<div class="card-header">
					<h3>
						<span class="lang-pt">{exp.data.role}</span>
						<span class="lang-en">{exp.data.en?.role ?? exp.data.role}</span>
					</h3>
					<span class="date">
						<span class="lang-pt">{exp.data.period}</span>
						<span class="lang-en">{exp.data.en?.period ?? exp.data.period}</span>
					</span>
				</div>
				<h4 class="company">
					<span class="lang-pt">{exp.data.company}</span>
					<span class="lang-en">{exp.data.en?.company ?? exp.data.company}</span>
				</h4>
				<ul class="lang-pt">
					{exp.data.highlights.map((highlight) => (
						<li set:html={highlight} />
					))}
				</ul>
				<ul class="lang-en">
					{(exp.data.en?.highlights ?? exp.data.highlights).map((highlight) => (
						<li set:html={highlight} />
					))}
				</ul>
			</div>
		))
	}
</section>
