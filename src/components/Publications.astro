---
import { getCollection } from "astro:content";

const allPublications = (await getCollection("publications")).sort(
	(a, b) => a.data.order - b.data.order
);
---

<section id="publicacoes">
	<h2>
		<span class="cyan">#</span>
		<span class="lang-pt">Publicações</span>
		<span class="lang-en">Publications</span>
	</h2>

	<div class="publications-grid">
		{
			allPublications.map((pub) => (
				<div class="card">
					<div class="card-header">
						<h3>{pub.data.venue}</h3>
						<span class="date">
							<span class="lang-pt">{pub.data.date}</span>
							<span class="lang-en">{pub.data.en?.date ?? pub.data.date}</span>
						</span>
					</div>
					<h4 class="company">
						<span class="lang-pt">{pub.data.type}</span>
						<span class="lang-en">{pub.data.en?.type ?? pub.data.type}</span>
					</h4>
					<ul class="lang-pt">
						<li>
							<strong>Título:</strong> <em>{pub.data.paperTitle}</em>
						</li>
						<li>
							<strong>Autores:</strong> {pub.data.authors}
						</li>
						<li>
							<strong>Resumo:</strong> {pub.data.abstract}
						</li>
						<li>
							<strong>DOI:</strong>{" "}
							<a
								href={`https://doi.org/${pub.data.doi}`}
								target="_blank"
								rel="noopener noreferrer"
								class="repo-link"
							>
								{pub.data.doi} ↗
							</a>
						</li>
					</ul>
					<ul class="lang-en">
						<li>
							<strong>Title:</strong> <em>{pub.data.en?.paperTitle ?? pub.data.paperTitle}</em>
						</li>
						<li>
							<strong>Authors:</strong> {pub.data.authors}
						</li>
						<li>
							<strong>Abstract:</strong> {pub.data.en?.abstract ?? pub.data.abstract}
						</li>
						<li>
							<strong>DOI:</strong>{" "}
							<a
								href={`https://doi.org/${pub.data.doi}`}
								target="_blank"
								rel="noopener noreferrer"
								class="repo-link"
							>
								{pub.data.doi} ↗
							</a>
						</li>
					</ul>
				</div>
			))
		}
	</div>
</section>
